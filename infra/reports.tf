# Weekly meetings report (Lab 5, was infra/reports.yml): a report-builder
# Lambda in the VPC queries Aurora and writes a CSV to S3, woken by
# EventBridge Scheduler through an SQS queue (with a dead-letter queue) or by
# `make report-now`. A report-mailer Lambda outside the VPC reacts to the file
# landing in S3 and emails it through SES - the two functions never call each
# other, only the S3 event connects them.

locals {
  reports_bucket = "${var.project_name}-reports-${local.account_id}"

  # Role names and the permission's statement id were generated by
  # CloudFormation. They are kept as they are: a new name is a new role, and
  # these were imported, not re-created.
  builder_role_name   = "${var.project_name}-reports-BuilderRole-h7v0UYRuoa3q"
  mailer_role_name    = "${var.project_name}-reports-MailerRole-LZMU5pk5FKxu"
  scheduler_role_name = "${var.project_name}-reports-SchedulerRole-8ElOqRd0OpM3"
  mailer_s3_statement = "${var.project_name}-reports-MailerS3InvokePermission-mhVTji2apTec"
}

# --- storage --------------------------------------------------------------

# The bucket holds every report built so far. Imported, not re-created;
# bucket is a "forces replacement" attribute.
resource "aws_s3_bucket" "reports" {
  bucket = local.reports_bucket
}

resource "aws_s3_bucket_public_access_block" "reports" {
  bucket = aws_s3_bucket.reports.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_lifecycle_configuration" "reports" {
  bucket = aws_s3_bucket.reports.id

  rule {
    id     = "expire-old-reports"
    status = "Enabled"

    filter {
      prefix = "reports/"
    }

    expiration {
      days = 90
    }
  }
}

# The bucket, the mailer's permission and this notification are three
# separate resources here, so CloudFormation's circular dependency (and the
# explicit-name trick that broke it) is gone: Terraform orders them from the
# references alone.
resource "aws_s3_bucket_notification" "reports" {
  bucket = aws_s3_bucket.reports.id

  lambda_function {
    lambda_function_arn = aws_lambda_function.mailer.arn
    events              = ["s3:ObjectCreated:*"]
    filter_prefix       = "reports/"
    filter_suffix       = ".csv"
  }

  depends_on = [aws_lambda_permission.mailer_s3]
}

resource "aws_vpc_endpoint" "reports_s3" {
  vpc_id            = local.backend_vpc.vpc_id
  service_name      = "com.amazonaws.${local.region}.s3"
  vpc_endpoint_type = "Gateway"
  route_table_ids   = [data.aws_route_table.main.id]
}

# --- queue ----------------------------------------------------------------

resource "aws_sqs_queue" "report_requests_dlq" {
  name                      = "${var.project_name}-report-requests-dlq"
  message_retention_seconds = 1209600 # 14 days
  max_message_size          = 1048576 # SQS's default since 2025; the provider still assumes 256 KiB
}

resource "aws_sqs_queue" "report_requests" {
  name                       = "${var.project_name}-report-requests"
  visibility_timeout_seconds = var.queue_visibility_timeout_seconds
  max_message_size           = 1048576

  redrive_policy = jsonencode({
    deadLetterTargetArn = aws_sqs_queue.report_requests_dlq.arn
    maxReceiveCount     = 3
  })
}

# --- builder (in the VPC) -------------------------------------------------

resource "aws_cloudwatch_log_group" "builder" {
  name              = "/aws/lambda/${var.project_name}-report-builder"
  retention_in_days = var.log_retention_days
}

resource "aws_iam_role" "builder" {
  name = local.builder_role_name

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "lambda.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "builder_vpc" {
  role       = aws_iam_role.builder.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole"
}

resource "aws_iam_role_policy" "builder_write_reports" {
  name = "write-reports"
  role = aws_iam_role.builder.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = "s3:PutObject"
      Resource = "${aws_s3_bucket.reports.arn}/reports/*"
    }]
  })
}

resource "aws_iam_role_policy" "builder_consume_requests" {
  name = "consume-report-requests"
  role = aws_iam_role.builder.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"]
      Resource = aws_sqs_queue.report_requests.arn
    }]
  })
}

resource "aws_lambda_function" "builder" {
  function_name = "${var.project_name}-report-builder"
  description   = "${var.project_name} weekly report builder"
  role          = aws_iam_role.builder.arn

  # The backend's image, a different handler - so the builder gets
  # app.reports for free. Terraform creates the function with the backend's
  # current image; every later image is the application pipeline's job
  # (scripts/deploy-backend.sh), not Terraform's - see the ADR, "two roads".
  package_type  = "Image"
  image_uri     = local.image_uri
  architectures = [var.lambda_architecture]

  image_config {
    command = ["app.reports.lambda_handler.handler"]
  }

  lifecycle {
    ignore_changes = [image_uri]
  }

  memory_size = var.builder_memory_size
  timeout     = var.builder_timeout_seconds

  logging_config {
    log_format = "Text"
    log_group  = aws_cloudwatch_log_group.builder.name
  }

  vpc_config {
    subnet_ids         = local.backend_vpc.subnet_ids
    security_group_ids = local.backend_vpc.security_group_ids
  }

  environment {
    variables = {
      DATABASE_URL   = data.aws_secretsmanager_secret_version.database_url.secret_string
      DB_POOLING     = "false"
      REPORTS_BUCKET = aws_s3_bucket.reports.bucket
      LOG_LEVEL      = "INFO"
    }
  }
}

resource "aws_lambda_event_source_mapping" "builder" {
  event_source_arn = aws_sqs_queue.report_requests.arn
  function_name    = aws_lambda_function.builder.arn
  batch_size       = 1
}

# --- schedule -------------------------------------------------------------

resource "aws_iam_role" "scheduler" {
  name = local.scheduler_role_name

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "scheduler.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy" "scheduler_send" {
  name = "send-report-request"
  role = aws_iam_role.scheduler.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = "sqs:SendMessage"
      Resource = aws_sqs_queue.report_requests.arn
    }]
  })
}

resource "aws_scheduler_schedule" "weekly" {
  name                         = "${var.project_name}-weekly-report"
  schedule_expression          = var.report_schedule_expression
  schedule_expression_timezone = var.report_schedule_timezone

  flexible_time_window {
    mode = "OFF"
  }

  target {
    arn      = aws_sqs_queue.report_requests.arn
    role_arn = aws_iam_role.scheduler.arn
    input    = jsonencode({ source = "schedule" })

    retry_policy {
      maximum_event_age_in_seconds = 86400
      maximum_retry_attempts       = 185
    }
  }
}

# --- mailer (outside the VPC) ---------------------------------------------

resource "aws_cloudwatch_log_group" "mailer" {
  name              = "/aws/lambda/${var.project_name}-report-mailer"
  retention_in_days = var.log_retention_days
}

resource "aws_iam_role" "mailer" {
  name = local.mailer_role_name

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "lambda.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "mailer_basic" {
  role       = aws_iam_role.mailer.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

resource "aws_iam_role_policy" "mailer_read_and_send" {
  name = "read-reports-and-send-mail"
  role = aws_iam_role.mailer.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect   = "Allow"
        Action   = "s3:GetObject"
        Resource = "${aws_s3_bucket.reports.arn}/reports/*"
      },
      {
        # sesv2.send_email with Content.Raw maps to the classic SendRawEmail
        # IAM action, not SendEmail - AWS keeps the old action names even
        # behind the new API.
        Effect   = "Allow"
        Action   = ["ses:SendEmail", "ses:SendRawEmail"]
        Resource = "*"
      },
    ]
  })
}

# Plain Python, no dependencies: zipped from the repository on every run.
data "archive_file" "mailer" {
  type        = "zip"
  output_path = "${path.module}/.build/report_mailer.zip"

  source {
    content  = file("${path.module}/lambda/report_mailer.py")
    filename = "index.py"
  }
}

resource "aws_lambda_function" "mailer" {
  function_name = "${var.project_name}-report-mailer"
  description   = "${var.project_name} weekly report mailer"
  role          = aws_iam_role.mailer.arn

  runtime          = "python3.13"
  handler          = "index.handler"
  filename         = data.archive_file.mailer.output_path
  source_code_hash = data.archive_file.mailer.output_base64sha256

  memory_size = 256
  timeout     = 30

  logging_config {
    log_format = "Text"
    log_group  = aws_cloudwatch_log_group.mailer.name
  }

  environment {
    variables = {
      REPORT_SENDER    = var.report_sender_email
      REPORT_RECIPIENT = var.report_recipient_email
      LOG_LEVEL        = "INFO"
    }
  }
}

resource "aws_lambda_permission" "mailer_s3" {
  statement_id   = local.mailer_s3_statement
  action         = "lambda:InvokeFunction"
  function_name  = aws_lambda_function.mailer.function_name
  principal      = "s3.amazonaws.com"
  source_arn     = aws_s3_bucket.reports.arn
  source_account = local.account_id
}

# --- SES identities -------------------------------------------------------
# Sandbox: no domain, so one identity per distinct address. Each sends an
# AWS verification email that has to be clicked before sending works.

resource "aws_sesv2_email_identity" "sender" {
  email_identity = var.report_sender_email
}

resource "aws_sesv2_email_identity" "recipient" {
  count          = var.report_recipient_email != var.report_sender_email ? 1 : 0
  email_identity = var.report_recipient_email
}
