# Agenda parser (Lab 6, was infra/ai.yml): a Lambda function outside the VPC
# and with no database that turns pasted text into a structured agenda
# through Claude on Amazon Bedrock. Same image as the backend, a different
# handler. Its function URL is public but authenticated (the handler checks a
# Cognito token) and $0 when idle; a $5/month budget alert is the backstop.

locals {
  # Generated by CloudFormation, kept as they are (see reports.tf).
  parser_role_name          = "${var.project_name}-ai-ExecutionRole-BWVDMMfROCe6"
  parser_url_statement      = "${var.project_name}-ai-FunctionUrlPermission-ItwztC1HxhLP"
  parser_invoke_statement   = "${var.project_name}-ai-FunctionUrlInvokePermission-9rOtBm6Sf54l"
  parser_cors_allow_origins = [var.local_origin, local.site_url]
}

resource "aws_cloudwatch_log_group" "parser" {
  name              = "/aws/lambda/${var.project_name}-agenda-parser"
  retention_in_days = var.log_retention_days
}

resource "aws_iam_role" "parser" {
  name = local.parser_role_name

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "lambda.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
}

# No VPC access policy: this function never joins the VPC.
resource "aws_iam_role_policy_attachment" "parser_basic" {
  role       = aws_iam_role.parser.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

resource "aws_iam_role_policy" "parser_call_bedrock" {
  name = "call-bedrock"
  role = aws_iam_role.parser.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      # "*" for now - narrowing it to the inference profiles this project
      # uses is a Lab 6 discussion question, left wide to keep the lab moving.
      Effect   = "Allow"
      Action   = "bedrock:InvokeModel"
      Resource = "*"
    }]
  })
}

resource "aws_lambda_function" "parser" {
  function_name = "${var.project_name}-agenda-parser"
  description   = "${var.project_name} agenda parser (text -> structured agenda via Claude on Bedrock)"
  role          = aws_iam_role.parser.arn

  package_type  = "Image"
  image_uri     = local.image_uri
  architectures = [var.lambda_architecture]

  image_config {
    command = ["app.ai.agenda_lambda.handler"]
  }

  # New images arrive through the application pipeline, as for the report
  # builder (reports.tf).
  lifecycle {
    ignore_changes = [image_uri]
  }

  memory_size = var.parser_memory_size
  timeout     = var.parser_timeout_seconds

  logging_config {
    log_format = "Text"
    log_group  = aws_cloudwatch_log_group.parser.name
  }

  # No vpc_config: no database to reach, so no network interfaces, no NAT.
  environment {
    variables = {
      PARSER_MODEL      = var.parser_model
      AUTH_USER_POOL_ID = aws_cognito_user_pool.main.id
      AUTH_CLIENT_ID    = aws_cognito_user_pool_client.frontend.id
      LOG_LEVEL         = "INFO"
    }
  }
}

# CORS on the function URL itself, not in the handler: only POST, only from
# the site's own origins.
resource "aws_lambda_function_url" "parser" {
  function_name      = aws_lambda_function.parser.function_name
  authorization_type = "NONE"

  cors {
    allow_origins = local.parser_cors_allow_origins
    allow_methods = ["POST"]
    allow_headers = ["content-type", "authorization"]
    max_age       = 300
  }
}

# The two statements a public function URL needs since October 2025.
resource "aws_lambda_permission" "parser_url_public" {
  statement_id           = local.parser_url_statement
  action                 = "lambda:InvokeFunctionUrl"
  function_name          = aws_lambda_function.parser.function_name
  principal              = "*"
  function_url_auth_type = "NONE"
}

resource "aws_lambda_permission" "parser_url_invoke" {
  statement_id             = local.parser_invoke_statement
  action                   = "lambda:InvokeFunction"
  function_name            = aws_lambda_function.parser.function_name
  principal                = "*"
  invoked_via_function_url = true
}

resource "aws_budgets_budget" "parser" {
  name         = "${var.project_name}-agenda-parser-monthly"
  budget_type  = "COST"
  time_unit    = "MONTHLY"
  limit_amount = format("%.1f", var.budget_amount)
  limit_unit   = "USD"

  notification {
    notification_type          = "ACTUAL"
    comparison_operator        = "GREATER_THAN"
    threshold                  = 80
    threshold_type             = "PERCENTAGE"
    subscriber_email_addresses = [var.budget_email]
  }

  notification {
    notification_type          = "ACTUAL"
    comparison_operator        = "GREATER_THAN"
    threshold                  = 100
    threshold_type             = "PERCENTAGE"
    subscriber_email_addresses = [var.budget_email]
  }
}
