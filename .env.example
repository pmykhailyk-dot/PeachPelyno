# --- database ---
POSTGRES_USER=spry
POSTGRES_PASSWORD=spry
POSTGRES_DB=spry
POSTGRES_PORT=5432

# --- backend ---
DATABASE_URL=postgresql+asyncpg://spry:spry@db:5432/spry
BACKEND_PORT=8000
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# --- frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000

# --- aws (make deploy-backend / deploy-frontend / domain) ---
# Everything lands in us-east-1, tagged PROJECT_NAME=<PROJECT_NAME>. Every
# other knob has a default in the scripts or templates and can still be set
# here to override it.
AWS_REGION=us-east-1
PROJECT_NAME=spry
# Blank keys fall back to AWS_PROFILE, SSO, or an instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=

# The deployed frontend's origin, once it has one.
API_CORS_ORIGINS=*

# --- written by the scripts, not by hand ---
# make deploy-backend: the function URL. make deploy-frontend builds against it.
BACKEND_URL=
# make domain-frontend DOMAIN=app.example.com: the frontend's custom domain.
DOMAIN_NAME=
# make domain-backend DOMAIN=api.example.com: the API's custom domain.
API_DOMAIN_NAME=

# --- auth / cognito (make deploy-auth) ---
# From a Google Cloud OAuth client (type: Web application) whose authorized
# JavaScript origin and redirect URI point at the Cognito domain below, not at
# the site. Never commit this file - it is gitignored.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: Cognito hosted-domain prefix. Defaults to "<PROJECT_NAME>-<account id>",
# which is unique across every AWS account without you having to pick one.
COGNITO_DOMAIN_PREFIX=

# --- written by make deploy-auth, not by hand ---
AUTH_USER_POOL_ID=
AUTH_CLIENT_ID=
AUTH_COGNITO_DOMAIN=
AUTH_AUTHORITY=
AUTH_REDIRECT_URI=
AUTH_LOGOUT_URI=

# --- weekly report (make deploy-reports / report-now) ---
# Needs make deploy-backend first - it reuses that stack's image, VPC and
# database secret. Without a domain attached to this project, sender and
# recipient are the same verified address (SES sandbox requires both
# verified either way); set REPORT_SENDER_EMAIL / REPORT_RECIPIENT_EMAIL
# separately once you have a domain identity for the sender.
REPORT_EMAIL=
REPORT_SENDER_EMAIL=
REPORT_RECIPIENT_EMAIL=
# cron(0 7 ? * MON *) / Europe/Kyiv are the template defaults; override here
# only to test, e.g. REPORT_SCHEDULE_EXPRESSION="rate(5 minutes)".
REPORT_SCHEDULE_EXPRESSION=
REPORT_SCHEDULE_TIMEZONE=
