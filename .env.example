# --- database ---
POSTGRES_USER=spry
POSTGRES_PASSWORD=spry
POSTGRES_DB=spry
POSTGRES_PORT=5432

# --- backend ---
DATABASE_URL=postgresql+asyncpg://spry:spry@db:5432/spry
BACKEND_PORT=8000
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# --- frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000

# --- aws (make deploy-backend / deploy-frontend / domain) ---
# Everything lands in us-east-1, tagged PROJECT_NAME=<PROJECT_NAME>. Every
# other knob has a default in the scripts or templates and can still be set
# here to override it.
AWS_REGION=us-east-1
PROJECT_NAME=spry
# Blank keys fall back to AWS_PROFILE, SSO, or an instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=

# The deployed frontend's origin, once it has one.
API_CORS_ORIGINS=*

# --- written by the scripts, not by hand ---
# make deploy-backend: the function URL. make deploy-frontend builds against it.
BACKEND_URL=
# make domain-frontend DOMAIN=app.example.com: the frontend's custom domain.
DOMAIN_NAME=
# make domain-backend DOMAIN=api.example.com: the API's custom domain.
API_DOMAIN_NAME=

# --- infrastructure: Terraform (infra/, Lab 7) ---
# Cognito, the weekly report and the agenda parser are Terraform's now, run
# remotely by HCP Terraform - nothing in this file feeds them. The Google
# client secret and the email addresses live in the spry-dev workspace as
# (sensitive) variables, not here and not in the repo. See README.md.

# --- written by make infra-env (terraform output), not by hand ---
# deploy-frontend.sh compiles these into the bundle as NEXT_PUBLIC_*; CI has
# no .env and looks the same values up by name instead.
AUTH_USER_POOL_ID=
AUTH_CLIENT_ID=
AUTH_COGNITO_DOMAIN=
AUTH_AUTHORITY=
AUTH_REDIRECT_URI=
AUTH_LOGOUT_URI=
PARSER_URL=

# --- agenda parser, from the laptop (make llm-hello / make parse) ---
# Bedrock model access must be granted in the AWS console (Model catalog,
# us-east-1) before any of this works. The deployed parser's model is the
# parser_model Terraform variable.
PARSER_MODEL=us.anthropic.claude-opus-4-5-20251101-v1:0
